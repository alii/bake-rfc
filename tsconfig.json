{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "types": ["bun"],
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "paths": {
      "default-framework/app": ["./frameworks/default/app.ts"],
      "rsc-sketch/app": ["./advanced/rsc/app.ts"]
    }
  },
  "include": ["types/*.d.ts", "apps/**/*.ts", "apps/**/*.tsx", "frameworks/**/*.ts", "frameworks/**/*.tsx", "advanced/**/*.ts", "advanced/**/*.tsx"]
}
