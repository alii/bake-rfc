{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "types": [
      "bun"
    ],
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": [
    "types/*.d.ts",
    "*/**/*.ts",
    "*/**/*.tsx"
  ]
}
